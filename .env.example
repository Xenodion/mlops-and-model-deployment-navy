# Copy to .env (git-ignored) and adapt. docker compose reads .env automatically.
# Never commit real secrets: production credentials live on the prod host only.

# S3 storage (SeaweedFS), dev defaults from docker-compose.yml
S3_ACCESS_KEY=mlops
S3_SECRET_KEY=mlops-secret

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ride-classifier
MODEL_NAME=ride-classifier
# Download artifacts through the server: the direct S3 links it would hand out use the Docker-internal
# name http://s3:8333, unreachable from outside Docker. (Our package sets this by default.)
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false

# API
MODEL_URI=model
PREDICTION_LOG_PATH=logs/predictions.jsonl

# Web app
API_URL=http://localhost:8000
